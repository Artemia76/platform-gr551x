+// platform-gr551x : ajout (absent d'ArduinoCore-API)
+size_t Print::printf(const char *format, ...)
+{
+  char buf[128];
+  va_list ap;
+  va_start(ap, format);
+  int n = vsnprintf(buf, sizeof(buf), format, ap);
+  va_end(ap);
+  if (n < 0) return 0;
+  if ((size_t)n < sizeof(buf)) return write((const uint8_t *)buf, n);
+  char *big = (char *)malloc(n + 1);
+  if (!big) return write((const uint8_t *)buf, sizeof(buf) - 1);
+  va_start(ap, format);
+  vsnprintf(big, n + 1, format, ap);
+  va_end(ap);
+  size_t w = write((const uint8_t *)big, n);
+  free(big);
+  return w;
+}
